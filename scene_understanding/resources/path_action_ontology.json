{
  "schema": "citv_path_action_ontology_v1",
  "version": "1.0",
  "notes": "CPU-first default policy for caption-aware affordance, action, path, and trajectory contracts. Override with config.path_action_ontology or config.path_action_ontology_json.",
  "action_prompts": {
    "walk": ["walk", "walking", "ground", "floor", "road", "path", "sidewalk", "terrain"],
    "run": ["run", "running", "open floor", "open path", "road", "track"],
    "swim": ["swim", "swimming", "water", "liquid", "pool", "lake", "river", "sea", "ocean"],
    "float": ["float", "floating", "water", "liquid", "surface", "air"],
    "fly": ["fly", "flying", "sky", "air", "above", "ceiling", "open air"],
    "hover": ["hover", "hovering", "sky", "air", "above", "floating"],
    "climb": ["climb", "climbing", "stairs", "ladder", "slope", "ramp", "wall", "step"],
    "crawl": ["crawl", "crawling", "under", "low", "narrow", "gap"],
    "hold": ["hold", "holding", "handle", "grip", "hand", "tool", "object"],
    "touch": ["touch", "contact", "edge", "surface", "button", "handle"],
    "peek": ["peek", "peeking", "behind", "edge", "corner", "occluded", "foreground"],
    "hide": ["hide", "hiding", "behind", "inside", "covered", "occluded"],
    "disappear": ["disappear", "vanish", "portal", "door", "entry", "exit", "inside"],
    "enter": ["enter", "entry", "door", "portal", "opening", "inside"],
    "exit": ["exit", "door", "portal", "opening", "outside"],
    "reflect": ["reflect", "reflection", "mirror", "glass", "shiny", "transparent"],
    "wobble": ["wobble", "ripple", "reflection", "glass", "water", "liquid", "mirror"],
    "approach": ["approach", "near", "toward", "beside", "next to", "in front"],
    "interact": ["interact", "use", "with", "on", "near", "touch", "hold"],
    "avoid": ["avoid", "obstacle", "block", "barrier", "occluder", "foreground"]
  },
  "role_prompts": {
    "actor": ["person", "animal", "vehicle", "character", "body", "face", "hand"],
    "hard_obstacle": ["wall", "barrier", "fence", "pole", "tree", "rock", "building"],
    "soft_obstacle": ["chair", "table", "sofa", "furniture", "plant", "box", "bag"],
    "support": ["floor", "ground", "road", "table", "desk", "seat", "chair", "bed", "shelf"],
    "container": ["cup", "bowl", "box", "bag", "sink", "pool", "container", "inside"],
    "portal": ["door", "doorway", "gate", "window", "opening", "entrance", "exit", "portal"],
    "liquid": ["water", "liquid", "pool", "lake", "river", "sea", "ocean", "drink"],
    "reflective_transparent": ["mirror", "glass", "window", "transparent", "reflection", "shiny"],
    "interaction_target": ["button", "handle", "tool", "screen", "device", "object", "door"],
    "occluder": ["foreground", "front", "behind", "occlude", "covered", "wall", "furniture"],
    "sky_open_air": ["sky", "air", "cloud", "ceiling", "above", "open air"]
  },
  "label_quality": {
    "generic_labels": ["object", "objects", "thing", "things", "item", "items", "entity", "entities"],
    "meta_visual_terms": [
      "blurred",
      "blurry",
      "photograph",
      "photo",
      "picture",
      "image",
      "portrait",
      "background",
      "abstract",
      "view",
      "scene",
      "shot",
      "closeup",
      "close",
      "focus",
      "focused",
      "unfocused"
    ],
    "meta_visual_phrases": [
      "blurred photograph",
      "blurred portrait",
      "blurred abstract background",
      "blurred abstract blurred",
      "blurred background",
      "abstract background",
      "blurred image",
      "blurred picture"
    ],
    "notes": "These terms are visual/caption quality evidence. They should not become canonical object semantics unless a downstream config intentionally permits them."
  },
  "scoring": {
    "prompt_hit_lambda": 0.55,
    "top_score_min_score": 0.01,
    "global_generated_confidence": 0.72,
    "global_fallback_confidence": 0.45,
    "global_precision": 0.55,
    "object_text_floor_confidence": 0.45,
    "region_confidence": 0.58,
    "region_precision": 0.48,
    "relation_default_confidence": 0.5,
    "relation_precision": 0.5,
    "uncertainty_confidence": 0.65,
    "uncertainty_precision": 0.35,
    "caption_precision_base": 0.28,
    "caption_precision_token_bonus": 0.025,
    "caption_precision_token_bonus_cap": 0.42,
    "caption_precision_uncertainty_penalty": 0.12,
    "caption_precision_min": 0.05,
    "caption_precision_max": 0.95,
    "aggregate_std_bonus": 0.25,
    "object_anchor_pad_min_px": 4.0,
    "object_anchor_pad_fraction": 0.25,
    "object_anchor_pad_max_px": 32.0,
    "support_patch_height_fraction": 0.18,
    "support_patch_min_px": 2
  },
  "mask_path_mode_policy": {
    "inside": {"roles": ["container", "liquid"], "actions": ["hide"]},
    "outside": {"roles": ["hard_obstacle", "soft_obstacle"], "actions": ["avoid"]},
    "around": {"roles": ["hard_obstacle", "occluder"], "actions": ["avoid"]},
    "on": {"roles": ["support"], "actions": ["walk", "climb"]},
    "through": {"roles": ["portal"], "actions": ["enter", "exit"]},
    "above": {"roles": ["sky_open_air"], "actions": ["fly", "hover"]},
    "contact": {"roles": ["interaction_target"], "actions": ["hold", "touch"]},
    "effect": {"roles": ["reflective_transparent"], "actions": ["reflect", "wobble"]}
  },
  "manifold_policy": [
    {"manifold_type": "blob_path", "actions": ["swim", "float"], "roles": ["liquid"], "modes": ["inside"]},
    {"manifold_type": "volume_path", "actions": ["fly", "hover"], "roles": ["sky_open_air"], "modes": ["above"]},
    {"manifold_type": "occlusion_pulse", "actions": ["peek", "hide"], "roles": ["occluder"], "modes": []},
    {"manifold_type": "contact_patch", "actions": ["hold", "touch", "interact", "approach"], "roles": [], "modes": ["contact"]},
    {"manifold_type": "portal_path", "actions": ["disappear", "enter", "exit"], "roles": ["portal"], "modes": ["through"]},
    {"manifold_type": "effect_field", "actions": ["reflect", "wobble"], "roles": ["reflective_transparent"], "modes": ["effect"]},
    {"manifold_type": "contour_path", "actions": ["climb", "crawl"], "roles": [], "modes": []}
  ],
  "action_family_by_manifold": {
    "ribbon_path": "locomotion",
    "contour_path": "locomotion",
    "blob_path": "locomotion",
    "volume_path": "locomotion",
    "portal_path": "locomotion",
    "contact_patch": "contact_interaction",
    "occlusion_pulse": "occlusion_interaction",
    "effect_field": "visual_effect"
  },
  "render_contracts": {
    "default": {"layers": ["in_front", "partially_occluded"], "alpha_policy": "visibility_profile"},
    "occlusion_pulse": {"layers": ["behind_object", "partially_occluded", "in_front"], "alpha_policy": "peek_pulse"},
    "portal_path": {"layers": ["inside_mask", "behind_object"], "alpha_policy": "fade_disappear"},
    "effect_field": {"layers": ["reflected", "in_front"], "alpha_policy": "effect_opacity"},
    "volume_path": {"layers": ["in_front", "partially_occluded", "behind_object"], "alpha_policy": "depth_visibility"}
  },
  "trajectory_requirements_by_manifold": {
    "ribbon_path": {"requires_path_polyline": true},
    "contour_path": {"requires_path_polyline": true},
    "portal_path": {"requires_path_polyline": true, "requires_visibility_profile": true},
    "blob_path": {"requires_mask_interior": true},
    "volume_path": {"requires_volume_sampling": true, "requires_visibility_profile": true},
    "contact_patch": {"requires_contact_points": true},
    "occlusion_pulse": {"requires_visibility_profile": true},
    "effect_field": {"requires_effect_field": true}
  },
  "support_kind_policy": [
    {"kind": "open_air", "roles": ["sky_open_air"], "actions": ["fly", "hover"], "threshold": 0.2},
    {"kind": "liquid", "roles": ["liquid"], "actions": ["swim", "float"], "threshold": 0.2},
    {"kind": "portal", "roles": ["portal"], "actions": ["enter", "exit"], "threshold": 0.2},
    {"kind": "support_surface", "roles": ["support"], "actions": ["walk"], "threshold": 0.2},
    {"kind": "blocking", "roles": ["hard_obstacle", "occluder"], "actions": [], "threshold": 0.25}
  ],
  "motion_hint_policy": {
    "support_fraction_threshold": 0.25,
    "open_air_motion": "fly_or_hover",
    "liquid_motion": "swim_or_float",
    "support_motion_score": 0.65,
    "depth_delta_threshold_m": 0.35,
    "depth_motion_score": 0.55,
    "occluded_sample_fraction_threshold": 0.15,
    "occlusion_motion_score": 0.6,
    "high_path_cost_threshold": 0.65,
    "careful_motion_score": 0.52,
    "default_motion": "walk",
    "default_motion_score": 0.5
  },
  "path_score_weights": {
    "geometric_cost_weight": 0.55,
    "geometric_visibility_weight": 0.45,
    "semantic_base": 0.72,
    "semantic_blocking_penalty": 0.45,
    "semantic_caption_bonus": 0.18,
    "kinematic_base": 0.45,
    "kinematic_visibility_bonus": 0.35,
    "kinematic_cost_bonus": 0.2,
    "overall_base_weight": 0.45,
    "overall_geometric_weight": 0.25,
    "overall_semantic_weight": 0.2,
    "overall_caption_weight": 0.1
  },
  "visibility": {
    "sample_radius_min_px": 1.0,
    "sample_radius_max_px": 12.0,
    "sample_radius_width_fraction": 0.35,
    "depth_margin_m": 0.03,
    "in_front_threshold": 0.95,
    "partially_visible_threshold": 0.05
  },
  "overlay_colors_bgr": {
    "ribbon_path": [80, 220, 80],
    "blob_path": [230, 170, 70],
    "volume_path": [120, 210, 255],
    "contour_path": [255, 170, 90],
    "interior_path": [220, 220, 80],
    "portal_path": [180, 90, 255],
    "occlusion_pulse": [90, 140, 255],
    "contact_patch": [80, 230, 230],
    "effect_field": [230, 80, 210]
  }
}
